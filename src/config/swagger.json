{
  "openapi": "3.0.0",
  "info": {
    "title": "EMARKafe Backend API",
    "version": "1.0.0",
    "description": "EMARKafe Mobile App Backend API documentation with Supabase Authentication, aligned with current database schema and role permissions (Customer, Barista, Branch Manager, Admin)."
  },
  "servers": [
    {
      "url": "http://localhost:5001",
      "description": "Local Development Server"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "User registration, authentication and session endpoints"
    },
    {
      "name": "Branch",
      "description": "Branch locations and product availability/stock management endpoints"
    },
    {
      "name": "Cart",
      "description": "User shopping cart management endpoints"
    },
    {
      "name": "Category",
      "description": "Cafe category management endpoints (Admin)"
    },
    {
      "name": "Device Token",
      "description": "Register user FCM push notification tokens"
    },
    {
      "name": "Favorites",
      "description": "User product bookmarked/favorites endpoints"
    },
    {
      "name": "Loyalty",
      "description": "Customer loyalty stamps and rewards tracking endpoints"
    },
    {
      "name": "Menu",
      "description": "Cafe products retrieval and management endpoints"
    },
    {
      "name": "Option",
      "description": "Customizable product option groups and values endpoints"
    },
    {
      "name": "Order",
      "description": "Checkout, order history, cancel, and barista status management endpoints"
    },
    {
      "name": "Profile",
      "description": "User profile viewing and editing endpoints"
    },
    {
      "name": "Rating",
      "description": "Product rating and review score endpoints"
    },
    {
      "name": "Settings",
      "description": "System-wide global app configuration endpoints"
    },
    {
      "name": "System",
      "description": "System status and health check endpoints"
    },
    {
      "name": "Wallet",
      "description": "Wallet and QR payment operations"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter your Supabase JWT access token."
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health check",
        "description": "Checks if the server is healthy and running.",
        "responses": {
          "200": {
            "description": "Successful health check"
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "User registration",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 6
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully"
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "User login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful, returns tokens"
          },
          "400": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "User logout",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Logged out successfully"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Get authenticated user details",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user data retrieved"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/profile/me": {
      "get": {
        "tags": [
          "Profile"
        ],
        "summary": "Get current user profile",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Profile data retrieved"
          },
          "404": {
            "description": "Profile not found"
          }
        }
      },
      "put": {
        "tags": [
          "Profile"
        ],
        "summary": "Update user profile (Upsert)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "full_name": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "avatar_url": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated successfully"
          }
        }
      }
    },
    "/api/categories": {
      "get": {
        "tags": [
          "Category"
        ],
        "summary": "List all categories",
        "responses": {
          "200": {
            "description": "Categories list"
          }
        }
