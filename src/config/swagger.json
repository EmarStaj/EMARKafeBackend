          }
        }
      }
    },
    "/api/branches/{branchId}/products/{productId}": {
      "put": {
        "tags": [
          "Branch"
        ],
        "summary": "Toggle product availability at a branch (Barista, Manager, Admin)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "branchId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "is_available"
                ],
                "properties": {
                  "is_available": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stock status updated"
          }
        }
      }
    },
