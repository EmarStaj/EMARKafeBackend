PORT=5001
NODE_ENV=development

# Supabase Credentials
SUPABASE_URL=https://ngcrtjqmeuskwnkafccu.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Security & JWT (Required for Wallet QR generation)
JWT_SECRET=your-super-secret-jwt-key

# OneSignal Push Notifications (Optional)
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key

# Redis URL (Optional - Fallback to in-memory/Postgres if not provided)
REDIS_URL=

# CORS Allowed Origins (Comma separated or * for all)
ALLOWED_ORIGINS=*

# Admin Bootstrap Credentials (Optional)
ADMIN_EMAIL=admin@emarkafe.com
ADMIN_PASSWORD=Admin12345!

# Rate Limiting
RATE_LIMIT_ENABLED=true
